# Copy to .env in the project root for local development.
# These are non-secret defaults only; add your real values before production use.
APP_ENV=development
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend settings
DATABASE_URL=sqlite:///./backend/fintech.db
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=fintech_session
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30

# SMTP (leave blank unless configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
